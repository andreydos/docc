controller:
  JCasC:
    configScripts:
      credentials: |
        credentials:
          system:
            domainCredentials:
              - credentials:
                  - usernamePassword:
                      scope: GLOBAL
                      id: github-token
                      username: "${github_username}"
                      password: "${github_token}"
                      description: GitHub PAT
      pipeline-job: |
        jobs:
          - script: |
              pipelineJob('django-docker') {
                description('Build the Django image, push it to ECR, and update the Helm tag')
                triggers {
                  scm('H/2 * * * *')
                }
                definition {
                  cpsScm {
                    lightweight(false)
                    scriptPath('Jenkinsfile')
                    scm {
                      git {
                        remote {
                          url('${git_repo_url}')
                          credentials('github-token')
                        }
                        branches('*/${git_revision}')
                      }
                    }
                  }
                }
              }

              job('seed-job') {
                description('Job to generate pipeline for Django project')
                scm {
                  git {
                    remote {
                      url('${git_repo_url}')
                      credentials('github-token')
                    }
                    branches('*/${git_revision}')
                  }
                }
                steps {
                  dsl {
                    text('''
                      pipelineJob("django-docker") {
                        triggers {
                          scm("H/2 * * * *")
                        }
                        definition {
                          cpsScm {
                            lightweight(false)
                            scriptPath("Jenkinsfile")
                            scm {
                              git {
                                remote {
                                  url("${git_repo_url}")
                                  credentials("github-token")
                                }
                                branches("*/${git_revision}")
                              }
                            }
                          }
                        }
                      }
                    ''')
                  }
                }
              }
